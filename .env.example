# Proveedor del LLM usado para categorizar (solo si categorizacion.modelo_llm está definido)
ANTHROPIC_API_KEY=

# Ruta al archivo de configuración de la empresa
DTE_AGENT_CONFIG=config.yaml

# Si se define, la API exige el header X-API-Key con este valor
DTE_AGENT_API_KEY=

# Casilla de intercambio DTE (opcional, para `dte-agent correo`)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
